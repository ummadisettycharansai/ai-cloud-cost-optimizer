{
  "files.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/venv2": true,
    "**/__pycache__": true
  },
  "C_Cpp.files.exclude": {
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/venv2/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/venv2": true
  },
  "python.defaultInterpreterPath": "backend/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "./backend"
  ],
  "css.lint.unknownAtRules": "ignore"
}
