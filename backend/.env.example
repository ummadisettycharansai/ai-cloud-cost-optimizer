# Authentication
JWT_SECRET_KEY=super-secret-key-change-in-production
CREDENTIAL_ENCRYPTION_KEY=""  # Run backend/cloud_integrations/credential_manager.py (or let backend auto-generate on first run) to get a Fernet key

# Redis / Celery Background Tasks
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AWS Testing (Optional - Defaults to Mock)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# Azure Testing (Optional - Defaults to Mock)
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
# AZURE_SUBSCRIPTION_ID=...

# GCP Testing (Optional - Defaults to Mock)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=...
# GCP_BILLING_ACCOUNT_ID=...
